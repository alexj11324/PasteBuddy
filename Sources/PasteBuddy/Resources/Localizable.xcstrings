            "state": "translated",
            "value": "Sync is local-only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步仅限本地。"
          }
        }
      }
    },
    "message.sync_is_off_clipboard_data_stays_on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync is off. Clipboard data stays on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步已关闭。剪贴板数据会留在这台 Mac 上。"
          }
        }
      }
    },
    "message.text_recognition_requires_an_image_pin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text recognition requires an image pin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字识别需要图片贴图。"
          }
        }
      }
    },
    "message.the_clipboard_does_not_contain_supported_image": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard does not contain supported image, text, file, color, or LaTeX content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板中没有支持的图片、文本、文件、颜色或 LaTeX 内容。"
          }
        }
      }
    },
    "message.the_pinned_image_is_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pinned image is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贴图图片不可用。"
          }
        }
      }
    },
    "message.the_recently_closed_pin_can_no_longer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recently closed pin can no longer be restored from history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法再从历史中恢复最近关闭的贴图。"
          }
        }
      }
    },
    "message.the_same_local_privacy_boundary_covers_history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same local privacy boundary covers history, pinboards, search, Shortcuts, keyboard insertion, Share/Action imports, and MCP access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相同的本地隐私边界适用于历史记录、收藏板、搜索、快捷指令、键盘插入、共享/操作导入以及 MCP 访问。"
          }
        }
      }
    },
    "message.the_source_language_could_not_be_detected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source language could not be detected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检测源语言。"
          }
        }
      }
    },
    "message.there_is_no_text_to_translate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no text to translate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可翻译的文本。"
          }
        }
      }
    },
    "message.this_language_pair_is_not_supported_by": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This language pair is not supported by macOS Translation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 翻译不支持此语言组合。"
          }
        }
      }
    },
    "message.this_removes_all_local_clipboard_history_including": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes all local clipboard history, including pinned item memberships. This action cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除所有本地剪贴板历史，包括已固定项目的归属关系。此操作无法撤销。"
          }
        }
      }
    },
    "message.this_removes_every_unpinned_clipboard_item_from": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes every unpinned clipboard item from local history. Pinned items stay available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从本地历史中移除所有未固定的剪贴板项目。已固定项目仍会保留。"
          }
        }
      }
    },
    "message.touch_id_protects_access_to_the_history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID locks the history view. Encrypted mode keeps the local key in Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID 会锁定历史记录视图。加密模式会把本地密钥保存在 Keychain 中。"
          }
        }
      }
    },
    "mobile.action.configure_app_group.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the shared App Group store from the signed app and extension targets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已签名 App 和扩展 target 中使用共享的 App Group 存储。"
          }
        }
      }
    },
    "mobile.action.continue_without_automatic_capture.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Share or Action extension imports while paste access remains denied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
