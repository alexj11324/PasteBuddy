    },
    "mobile.card.keyboard_full_access_needed.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Full Access, the keyboard should stay in limited mode and avoid claiming it can read synced history. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
