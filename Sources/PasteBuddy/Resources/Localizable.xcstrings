    "message.pastebuddy_does_not_send_clipboard_payloads_to": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PasteBuddy does not send clipboard payloads to vendor servers for capture, search, OCR, keyboard insertion, Shortcuts, or local MCP access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PasteBuddy 不会将剪贴板内容发送到供应商服务器，用于捕获、搜索、OCR、键盘插入、Shortcuts 或本地 MCP 访问。"
          }
        }
      }
    },
    "message.pastebuddy_stores_only_the_hash_of_this": {
      "localizations": {
