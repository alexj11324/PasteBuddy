    "label.embedding_model": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Embedding Model" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "向量模型" } } } },
    "label.embedding_provider": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Embedding Provider" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "向量模型服务商" } } } },
    "label.multimodal_model": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Multimodal Model" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "多模态模型" } } } },
    "label.organization_id": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Organization ID" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "组织 ID" } } } },
    "label.pastebuddy_cloud": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "PasteBuddy Cloud" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "PasteBuddy 云端" } } } },
    "label.plan_byok_annual": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "BYOK Annual" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "BYOK 年付" } } } },
    "label.plan_cloud_annual": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Cloud Annual" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "云端年付" } } } },
    "label.plan_cloud_monthly": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Cloud Monthly" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "云端月付" } } } },
    "label.plan_free": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Free" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "免费" } } } },
    "label.plan_free_trial": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Free Trial" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "免费试用" } } } },
    "label.plan_team": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Team" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "团队" } } } },
    "label.project_id": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Project ID" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "项目 ID" } } } },
    "label.provider_gemini": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Gemini" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Gemini 服务" } } } },
    "label.provider_openai": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "OpenAI" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "OpenAI 服务" } } } },
    "label.provider_openai_compatible": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "OpenAI-compatible" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "OpenAI 兼容服务" } } } },
    "label.provider_openrouter": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "OpenRouter" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "OpenRouter 服务" } } } },
    "label.provider_sub2api": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sub2 API" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sub2 API 服务" } } } },
    "message.ai_byok_configuration_invalid": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The BYOK configuration is incomplete." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "BYOK 配置不完整。" } } } },
    "message.ai_byok_connection_failed": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The custom AI provider request failed." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "自定义 AI 服务请求失败。" } } } },
    "message.ai_byok_privacy_boundary": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Your API key stays in this device's Keychain. Clipboard content goes directly to the provider you configure. Memories and embeddings remain local." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "API 密钥仅保存在本机钥匙串中。剪贴板内容会直接发送给你配置的服务商；记忆和向量仍保存在本地。" } } } },
    "message.ai_byok_source_detail": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Use your own OpenAI, Gemini, or OpenAI-compatible API. The key is stored only in this device's Keychain." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "使用你自己的 OpenAI、Gemini 或 OpenAI 兼容 API；密钥只保存在本机钥匙串中。" } } } },
    "message.ai_cloud_source_detail": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "PasteBuddy sends only the item being indexed or the current query for stateless processing. The server does not store memories." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "PasteBuddy 只为无状态处理发送当前索引项目或查询；服务器不保存记忆。" } } } },
    "message.ai_connection_succeeded": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Connection succeeded. The API key was saved to this device's Keychain." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "连接成功，API 密钥已保存到本机钥匙串。" } } } },
    "message.ai_plan_comparison": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "BYOK Annual unlocks your own providers. Cloud Monthly and Cloud Annual include both PasteBuddy Cloud and BYOK. Every plan is a recurring subscription." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "BYOK 年付可使用自有服务商；云端月付和年付同时包含 PasteBuddy 云端与 BYOK。所有套餐均为自动续订订阅。" } } } },
    "message.ai_provider_configuration_required": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Choose an available AI provider and finish its configuration first." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "请先选择可用的 AI 服务并完成配置。" } } } },
    "message.ai_products_unavailable": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "AI subscription products are not available from the App Store right now. Try again later or restore purchases." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前无法从 App Store 获取 AI 订阅产品。请稍后重试或恢复购买。" } } } },
    "message.ai_reindex_required": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Changing the provider or models requires rebuilding the derived local index. Your original clipboard history is not changed." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "更换服务商或模型需要重建本地派生索引，不会修改原始剪贴板历史。" } } } },
    "message.ai_setup_summary": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Find what you remember across your clipboard history. The searchable index always stays on this Mac." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "按你记得的内容查找剪贴板历史；可搜索索引始终保存在这台 Mac 上。" } } } },
    "message.ai_subscription_expiry_boundary": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "AI Search locks as soon as the subscription or verified introductory trial expires. Your local index remains available for deletion." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "订阅或经 App Store 验证的优惠试用一到期，AI 搜索会立即锁定；本地索引仍可删除。" } } } },
    "message.byok_annual_detail": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Annual BYOK access; provider usage is billed by your provider." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "按年解锁 BYOK；模型调用费用由服务商另行收取。" } } } },
    "message.byok_annual_option_detail": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Annual subscription for AI Search using your own provider keys." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "按年订阅 AI 搜索并使用你自己的服务商密钥。" } } } },
    "message.byok_annual_unlock": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Unlocks BYOK while the subscription remains active." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "订阅有效期间解锁 BYOK。" } } } },
    "message.ai_trial_canceled_outcome": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Canceled trials stop granting AI access; users can still activate a BYOK or Cloud subscription later." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "取消试用后将停止提供 AI 权限；之后仍可订阅 BYOK 或云端套餐。" } } } },
    "message.ai_trial_end_outcome": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "When the trial ends, PasteBuddy keeps local data and locks AI inference unless an active BYOK or Cloud subscription is available." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "试用结束后，PasteBuddy 会保留本地数据并锁定 AI 推理，除非存在有效的 BYOK 或云端订阅。" } } } },
    "message.cloud_annual_option_detail": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Annual subscription with PasteBuddy Cloud inference and BYOK." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "按年订阅 PasteBuddy 云端推理并包含 BYOK。" } } } },
    "message.cloud_annual_detail": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Annual PasteBuddy Cloud access, including BYOK." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "按年使用 PasteBuddy 云端，同时包含 BYOK。" } } } },
    "message.cloud_monthly_detail": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Monthly PasteBuddy Cloud access, including BYOK." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "按月使用 PasteBuddy 云端，同时包含 BYOK。" } } } },
    "message.cloud_monthly_option_detail": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Monthly subscription with PasteBuddy Cloud inference and BYOK." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "按月订阅 PasteBuddy 云端推理并包含 BYOK。" } } } },
    "message.cloud_subscription_unlock": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Unlocks Cloud and BYOK while the subscription remains active." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "订阅有效期间解锁云端和 BYOK。" } } } },
    "message.team_purchase_positioning": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Team is a business plan distinct from personal BYOK and Cloud subscriptions, with seat billing and admin-visible license state." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "团队版是独立于个人 BYOK 和云端订阅的商业套餐，提供席位计费和管理员可见的授权状态。" } } } },
    "state.testing_connection": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Testing connection…" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在测试连接…" } } } },
    "mcp.semantic_search_history": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Semantic Search History" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "语义搜索历史" } }
      }
    },
