    "message.record_clipboard": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Disable this option to stop recording new content. Existing history is retained."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "关闭后将停止记录新复制的内容，已有历史记录将予以保留。"}}}},
