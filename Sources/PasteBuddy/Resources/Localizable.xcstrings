    "label.skip_password_fields": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Exclude password fields and temporary content"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "排除密码框与临时内容"}}}},
    "message.skip_password_fields": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Password fields, password managers, and some applications mark the content they copy. Disable this option to record content copied from a password field."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "密码输入框、密码管理器及部分应用程序会为其复制的内容添加标记。如需记录从密码框复制的内容，请关闭此选项。"}}}},
    "label.guess_and_skip_secrets": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Exclude content that appears to be a secret"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "排除疑似密钥的内容"}}}},
    "message.guess_and_skip_secrets": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Detection is based on the text itself and may exclude content that should be retained."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "该判定依据文本内容进行，可能误判并排除需要保留的内容。"}}}},
