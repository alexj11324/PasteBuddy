    "mobile.share_action.favorite_reorder_guidance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Users can add Save to PasteBuddy and Copy to PasteBuddy to iOS Share sheet favorites and reorder them from the system Share sheet edit screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
