      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "AI gateway returned HTTP %d." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "AI 网关返回了 HTTP %d。" } }
      }
    },
