    "mobile.card.background_capture_limit.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background clipboard capture is limited"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台剪贴板捕获受限"
          }
        }
      }
    },
    "mobile.card.ipad_multitasking.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The native mobile browser uses an adaptive split layout for portrait, landscape, Stage Manager, Split View, Slide Over, and drag-and-drop into pinboards."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生移动端浏览器会针对竖屏、横屏、台前调度、分屏浏览、侧拉，以及拖放到收藏板使用自适应分栏布局。"
          }
