        }
      }
    },
    "message.copied_image_ocr_runs_on_device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text recognition uses Apple Vision on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字识别使用本机 Apple Vision 处理。"
          }
        }
      }
    },
    "message.copy_text_links_images_or_files_to": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy text, links, images, or files to start building local history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制文本、链接、图片或文件即可开始建立本地历史。"
          }
        }
      }
    },
    "message.custom_rules_run_locally_before_capture_and": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom rules run locally before capture and are stored with local history settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义规则会在捕获前于本地运行，并随本地历史设置保存。"
          }
        }
      }
    },
    "message.direct_paste_copies_the_selected_item_first": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct paste copies the selected item first, then sends Command-V only when macOS Accessibility access is granted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接粘贴会先复制所选项目，然后仅在已授予 macOS 辅助功能访问权限时发送 Command-V。"
          }
        }
      }
    },
    "message.direct_paste_clipboard_payload_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste was not sent because the clipboard payload was unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于剪贴板内容不可用，未执行粘贴。"
          }
        }
      }
    },
    "message.direct_paste_clipboard_payload_unavailable_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste failed - clipboard payload unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴失败——剪贴板内容不可用"
          }
