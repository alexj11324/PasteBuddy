    "message.pastebuddy_does_not_send_clipboard_payloads_to": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PasteBuddy does not send clipboard payloads to vendor servers for capture, search, OCR, keyboard insertion, Shortcuts, or local MCP access."
          }
