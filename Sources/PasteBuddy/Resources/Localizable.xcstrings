    "message.clear_source_app_filter_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the selected source app while keeping the other search and filter choices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除所选来源应用，并保留其他搜索与过滤条件。"
          }
        }
      }
    },
    "message.cleared_shortcuts_remain_available_from_menus_but": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleared shortcuts remain available from menus but no keyboard equivalent is registered. System-wide show/hide registration is kept in configuration for signed app builds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已清除的快捷键仍可通过菜单使用，但不会注册对应的键盘快捷方式。系统范围的显示/隐藏注册会保留在配置中，供已签名的应用构建使用。"
          }
        }
      }
    },
    "message.click_for_pastebuddy_menu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click for PasteBuddy menu."
          }
