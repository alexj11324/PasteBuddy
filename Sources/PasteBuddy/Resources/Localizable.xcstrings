    },
    "mobile.onboarding.allow_paste_from_other_apps.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use iOS Settings to move PasteBuddy from Ask to Allow when automatic capture is desired."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要自动捕获时，可在 iOS 设置中将 PasteBuddy 从“询问”改为“允许”。"
          }
        }
      }
    },
    "mobile.onboarding.allow_paste_from_other_apps.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Paste From Other Apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许从其他 App 粘贴"
          }
        }
      }
    },
    "mobile.onboarding.keyboard_full_access.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable only when the user wants the keyboard extension to read synced history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在用户希望键盘扩展读取已同步的历史时启用。"
          }
        }
      }
    },
    "mobile.onboarding.keyboard_full_access.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard Full Access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘完全访问"
          }
        }
      }
    },
    "mobile.onboarding.share_extension.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable the extension to save text, links, images, and files from the iOS Share sheet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用扩展后，可从 iOS 分享面板保存文本、链接、图片和文件。"
          }
        }
      }
    },
    "mobile.onboarding.share_extension.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share Extension"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享扩展"
          }
        }
      }
    },
    "mobile.paste_permission.allowed.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PasteBuddy may read pasteboard content after foreground user activity and local privacy rules still apply before anything is saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PasteBuddy 可在用户前台操作后读取剪贴板内容，并且保存任何内容前仍会应用本地隐私规则。"
          }
        }
      }
    },
    "mobile.paste_permission.allowed.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic capture is allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许自动捕获"
          }
        }
      }
    },
    "mobile.paste_permission.ask.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS will ask before PasteBuddy reads pasteboard content. Offer the Settings path only when the user wants automatic capture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会在 PasteBuddy 读取剪贴板内容前询问。仅在用户想启用自动捕获时提供设置路径。"
          }
        }
      }
    },
    "mobile.paste_permission.ask.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Paste From Other Apps is set to Ask"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“允许从其他 App 粘贴”设为询问"
          }
        }
      }
    },
    "mobile.paste_permission.dark_pattern_guardrail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not block app launch, hide manual workflows, or imply clipboard data leaves the device/iCloud to pressure the user into enabling Allow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要阻止应用启动、隐藏手动流程，或暗示剪贴板数据会离开设备/iCloud 来迫使用户启用“允许”。"
          }
        }
      }
    },
    "mobile.paste_permission.denial_not_fatal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PasteBuddy must not treat denial as fatal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PasteBuddy 不应把拒绝权限视为致命问题。"
          }
        }
      }
    },
    "mobile.paste_permission.denied.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic pasteboard capture is disabled. PasteBuddy should keep manual workflows available and offer Settings without blocking the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动剪贴板捕获已停用。PasteBuddy 应保留手动流程，并在不阻止使用应用的情况下提供设置入口。"
          }
        }
      }
    },
    "mobile.paste_permission.denied.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste access is denied"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴访问已被拒绝"
          }
        }
      }
    },
    "mobile.paste_permission.manual_workflows_remain_available": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual workflows remain available: browsing synced history, keyboard access, Share extension imports, and Action extension imports continue when automatic pasteboard capture is not allowed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动流程仍然可用：即使不允许自动剪贴板捕获，也可以继续浏览已同步的历史、使用键盘访问，以及通过分享扩展和操作扩展导入。"
          }
        }
      }
    },
    "mobile.paste_permission.settings_path": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings > Apps > PasteBuddy > Allow Paste From Other Apps > Allow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 > App > PasteBuddy > 允许从其他 App 粘贴 > 允许"
          }
        }
      }
    },
    "mobile.paste_permission.unknown.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explain why iOS asks before reading pasteboard content before attempting automatic capture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在尝试自动捕获前，先说明 iOS 为什么会在读取剪贴板内容前询问。"
          }
        }
      }
    },
    "mobile.paste_permission.unknown.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste permission has not been checked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未检查粘贴权限"
          }
        }
      }
    },
    "mobile.permission_state.allowed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许"
          }
        }
      }
    },
    "mobile.permission_state.ask": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "询问"
          }
        }
      }
    },
    "mobile.permission_state.denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Denied"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
    },
    "mobile.permission_state.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        },
        "zh-Hans": {
