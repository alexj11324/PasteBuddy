    "mobile.share_action.unsupported_input_explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PasteBuddy can save shared text, links, images, and supported file URLs. Unsupported provider payloads should fail with a clear message and no plaintext temporary files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PasteBuddy 可以保存分享的文本、链接、图片和受支持的文件 URL。不受支持的提供方载荷应给出清晰失败信息，且不留下明文临时文件。"
          }
        }
      }
    },
