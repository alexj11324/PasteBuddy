      }
    },
    "message.disabling_shared_pinboards_removes_sharing_metadata": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes sharing metadata from every Pinboard. Clipboard history and local Pinboard contents stay on this Mac."
