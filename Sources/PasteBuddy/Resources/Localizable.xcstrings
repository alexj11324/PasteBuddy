    "message.pinned_items_are_preserved_when_normal_history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned items are preserved when normal history expires, storage limits prune old content, or unpinned history is cleared. Use the explicit all-history action to remove pinned item memberships too."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当普通历史记录过期、存储限制清理旧内容，或未固定的历史记录被清除时，已固定项目会被保留。若要一并移除固定项目的归属关系，请使用明确的“清除所有历史记录”操作。"
          }
        }
      }
    },
