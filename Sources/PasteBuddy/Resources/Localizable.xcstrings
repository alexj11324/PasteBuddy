    "mobile.keyboard.full_access_privacy_explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access lets the keyboard read PasteBuddy's shared App Group history and insert selected text. Clipboard data stays on the user's device or private iCloud account unless the user explicitly enables sync or sharing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全访问权限允许键盘读取 PasteBuddy 共享的 App Group 历史并插入所选文本。除非用户明确启用同步或分享，剪贴板数据会保留在用户设备或私人 iCloud 账户中。"
          }
        }
      }
    },
    "mobile.keyboard_full_access_explanation.action_title": {
      "localizations": {
