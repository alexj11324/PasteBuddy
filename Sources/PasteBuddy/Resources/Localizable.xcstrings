    "mobile.background_clipboard_limitation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS and iPadOS do not permit dependable continuous background clipboard monitoring. PasteBuddy should browse synced or manually imported history, read the pasteboard only after foreground permission, and rely on Share or Action extensions for manual imports."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 和 iPadOS 不允许可靠的连续后台剪贴板监控。PasteBuddy 应浏览已同步或手动导入的历史，仅在前台获得权限后读取剪贴板，并依靠分享或操作扩展进行手动导入。"
          }
        }
      }
    },
    "mobile.card.action_extension_available.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable the action extension for one-tap Copy to PasteBuddy actions in compatible apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用操作扩展后，可在兼容 App 中一键使用“复制到 PasteBuddy”。"
          }
        }
      }
    },
