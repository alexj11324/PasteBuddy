      }
    },
    "message.clipboard_payloads_images_ocr_metadata_thumbnails_privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard data stays on this Mac unless you turn on sync, sharing, or MCP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板数据会留在这台 Mac，除非你打开同步、共享或 MCP。"
          }
        }
      }
    },
    "message.configure_cloudkit_sync_and_turn_on_shared": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure CloudKit sync and turn on Shared Pinboards before sharing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先配置 CloudKit 同步并开启共享收藏板，然后再分享。"
          }
        }
      }
    },
    "message.copied_image_ocr_requires_image_history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on copied image history to recognize text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先开启已复制图片历史，才能识别文字。"
