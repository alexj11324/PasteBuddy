    "mobile.automatic_capture.needs_user_consent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs User Consent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要用户同意"
          }
        }
      }
    },
    "mobile.background_clipboard_limitation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS and iPadOS do not permit dependable continuous background clipboard monitoring. PasteBuddy should browse synced or manually imported history, read the pasteboard only after foreground permission, and rely on Share or Action extensions for manual imports."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 和 iPadOS 不允许可靠的连续后台剪贴板监控。PasteBuddy 应浏览已同步或手动导入的历史，仅在前台获得权限后读取剪贴板，并依靠分享或操作扩展进行手动导入。"
          }
        }
      }
    },
    "mobile.card.action_extension_available.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable the action extension for one-tap Copy to PasteBuddy actions in compatible apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用操作扩展后，可在兼容 App 中一键使用“复制到 PasteBuddy”。"
          }
        }
      }
    },
    "mobile.card.action_extension_available.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action extension is available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作扩展可用"
          }
        }
      }
    },
    "mobile.card.action_extension_enabled.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action extension can save supported selections directly into history or the preferred pinboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作扩展可将受支持的所选内容直接保存到历史或首选收藏板。"
          }
        }
      }
    },
    "mobile.card.action_extension_enabled.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action extension is enabled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作扩展已启用"
          }
        }
      }
    },
    "mobile.card.app_group.needs.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled mobile extensions must use the shared App Group store rather than plaintext handoff files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用的移动端扩展必须使用共享的 App Group 存储，而不是明文交接文件。"
          }
        }
      }
    },
    "mobile.card.app_group.optional.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Group setup is only required when the signed app embeds keyboard, share, or action extensions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有签名后的 App 内嵌键盘、分享或操作扩展时，才需要设置 App Group。"
          }
        }
      }
    },
    "mobile.card.app_group.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
