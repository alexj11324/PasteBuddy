        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same local privacy boundary covers history, pinboards, search, Shortcuts, keyboard insertion, Share/Action imports, and MCP access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相同的本地隐私边界适用于历史记录、收藏板、搜索、快捷指令、键盘插入、共享/操作导入以及 MCP 访问。"
          }
        }
