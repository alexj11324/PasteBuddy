      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add PasteBuddy from iOS Keyboard settings when in-app paste access is needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要应用内粘贴访问时，可从 iOS 键盘设置添加 PasteBuddy。"
          }
        }
      }
    },
    "mobile.action.enable_keyboard_later.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Keyboard Later"
          }
        },
