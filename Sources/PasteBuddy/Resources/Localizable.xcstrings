    "label.enable_ai_search": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Enable AI Search" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "启用 AI 搜索" } }
      }
    },
    "label.pause_ai_indexing": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Pause Indexing" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "暂停索引" } }
      }
    },
    "message.ai_search_processing_consent": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Send eligible clipboard content to the stateless AI service and keep the resulting search index on this device." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "将符合条件的剪贴板内容发送到无状态 AI 服务，并将生成的搜索索引保存在此设备上。" } }
      }
    },
    "message.ai_search_local_storage_boundary": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The server does not store clipboard history or index results. Images are analyzed directly by a multimodal model; OCR is not required." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "服务器不保存剪贴板历史或索引结果。图片由多模态模型直接分析，不依赖 OCR。" } }
      }
    },
    "message.delete_ai_index_confirmation": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This permanently deletes all local AI search documents, embeddings, and queued work, then turns AI Search off. Clipboard history is not deleted." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这会永久删除所有本地 AI 搜索文档、向量和排队任务，并关闭 AI 搜索。剪贴板历史不会被删除。" } }
      }
    },
    "message.pause_ai_indexing_detail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Keep existing AI search results available but stop sending new items for indexing." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "保留现有 AI 搜索结果，但停止发送新项目进行索引。" } }
      }
    },
    "message.rebuild_ai_index_confirmation": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This deletes the current local AI index and queues all eligible clipboard items for indexing again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这会删除当前本地 AI 索引，并重新排队所有符合条件的剪贴板项目。" } }
      }
    },
